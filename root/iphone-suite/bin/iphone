#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

get_device_info() {
    MODEL=$(ideviceinfo 2>/dev/null | grep "ProductType" | cut -d ' ' -f 2)
    if [ -n "$MODEL" ]; then
        IOS_VER=$(ideviceinfo 2>/dev/null | grep "ProductVersion" | cut -d ' ' -f 2)
        NAME=$(ideviceinfo 2>/dev/null | grep "DeviceName" | cut -d ' ' -f 2-)
        INFO_STR="${GREEN}$NAME ($MODEL) | iOS: $IOS_VER | [Modo Normal]${NC}"
        return
    fi
    
    IRECV_MODE=$(irecovery -q 2>/dev/null | grep "MODE:" | cut -d ' ' -f 2)
    if [ -n "$IRECV_MODE" ]; then
        CPID=$(irecovery -q 2>/dev/null | grep "CPID:" | cut -d ' ' -f 2)
        PRODUCT=$(irecovery -q 2>/dev/null | grep "PRODUCT:" | cut -d ' ' -f 2)
        
        if [ "$IRECV_MODE" == "Recovery" ]; then
            INFO_STR="${MAGENTA}Dispositivo en [MODO RECOVERY] | Modelo: $PRODUCT | CPID: $CPID${NC}"
        elif [ "$IRECV_MODE" == "DFU" ]; then
            INFO_STR="${MAGENTA}Dispositivo en [MODO DFU] | Modelo: $PRODUCT | CPID: $CPID${NC}"
        else
            INFO_STR="${MAGENTA}Dispositivo conectado | Modo: $IRECV_MODE${NC}"
        fi
        return
    fi

    INFO_STR="${RED}Ningun dispositivo detectado (Revisa cable o usa Opcion 11)${NC}"
}

show_menu() {
    clear
    get_device_info
    echo -e "${CYAN}====================================================${NC}"
    echo -e "${YELLOW}   HERRAMIENTAS iOS INTELIGENTES Y UNIVERSALES      ${NC}"
    echo -e "${CYAN}====================================================${NC}"
    echo -e " [i] Estado actual: $INFO_STR"
    echo -e "${CYAN}====================================================${NC}"
    echo -e " Selecciona una opcion:"
    echo -e " ----------------------------------------------------"
    echo -e " ${GREEN} 1)${NC} Diagnóstico e Instalación Inteligente de Jailbreak"
    echo -e " ${RED}  2)${NC} Remover Jailbreak (Force Revert - palera1n)"
    echo -e " ${MAGENTA} 3)${NC} USBLiter8 Exploit (A12/A13 Pwn DFU / usbliter8_boot)"
    echo -e " ----------------------------------------------------"
    echo -e " ${GREEN} 4)${NC} Entrar a Recovery         -> (Manda iPhone a Recovery)"
    echo -e " ${GREEN} 5)${NC} Salir de Recovery         -> (Reinicia a Modo Normal)"
    echo -e " ${GREEN} 6)${NC} Ejecutar Gaster (Pwned DFU)-> (Exploit checkm8 A7-A11)"
    echo -e " ${GREEN} 7)${NC} Resetear Estado DFU       -> (Gaster reset en DFU)"
    echo -e " ${GREEN} 8)${NC} Salir de DFU              -> (Instrucciones USB + Botones)"
    echo -e " ----------------------------------------------------"
    echo -e " ${GREEN} 9)${NC} Ver Estado del iPhone     -> (Normal, Recovery o DFU)"
    echo -e " ${GREEN}10)${NC} Información Hardware      -> (Datos del chip/ECID)"
    echo -e " ${CYAN}11)${NC} Forzar Emparejamiento   -> (Manda aviso 'Confiar' al iPhone)"
    echo -e " ${CYAN}12)${NC} Ver Logs del Sistema    -> (Syslog en vivo del iPhone)"
    echo -e " ----------------------------------------------------"
    echo -e " ${GREEN}13)${NC} Reiniciar iPhone (Reboot) -> (Universal: Todo iPhone/iOS)"
    echo -e " ${GREEN}14)${NC} Hacer Respring (SSH)     -> (Solo si tiene Jailbreak activo)"
    echo -e " ${CYAN}15)${NC} Conectar por SSH Root   -> (Abre Terminal interna del iPhone)"
    echo -e " ${CYAN}16)${NC} Gestor IPAs [Requiere JB] -> (Instala apps solo con Jailbreak)"
    echo -e " ----------------------------------------------------"
    echo -e " ${BLUE}17)${NC} Extraer SHSH Blobs/ECID -> (Guardar datos para Downscale)"
    echo -e " ${BLUE}18)${NC} Diagnóstico de Batería  -> (Salud y ciclos de carga reales)"
    echo -e " ${BLUE}19)${NC} Analizador de Espacio   -> (Uso de almacenamiento interno)"
    echo -e " ${BLUE}20)${NC} Backup Express (Local)  -> (Copia de seguridad en Orange Pi)"
    echo -e " ${BLUE}21)${NC} Restaurar Backup Local  -> (Inyectar copia de respaldo)"
    echo -e " ${BLUE}22)${NC} Listar / Borrar Apps USB  -> (Gestionar aplicaciones instaladas)"
    echo -e " ${RED}23)${NC} Teclado PIN Remoto      -> (Desbloquear pantalla táctil rota con PIN)"
    echo -e " ${RED}24)${NC} Restablecer de Fábrica    -> (Borrado general / Erase All Content)"
    echo -e " ----------------------------------------------------"
    echo -e " ${RED}25)${NC} Salir del Menu"
    echo -e "${CYAN}====================================================${NC}"
    echo -e -n "Ingresa tu opcion [1-25]: "
}

smart_jailbreak() {
    echo -e "\n${YELLOW}[+] Analizando dispositivo conectado...${NC}"
    MODEL=$(ideviceinfo 2>/dev/null | grep "ProductType" | cut -d ' ' -f 2)
    IOS_VER=$(ideviceinfo 2>/dev/null | grep "ProductVersion" | cut -d ' ' -f 2)
    
    if [ -z "$MODEL" ]; then
        echo -e "${RED}[!] No se detecto dispositivo en Modo Normal.${NC}"
        echo -e "${YELLOW}[i] Si el equipo esta en DFU Mode:${NC}"
        echo -e "    - Para A7-A11 (iPhone 7, X, etc.): Selecciona la Opcion 6 (Gaster checkm8)."
        echo -e "    - Para A12-A13: Selecciona la Opcion 3 (USBLiter8)."
        return
    fi
    
    echo -e "${GREEN}[+] Dispositivo detectado: $MODEL con iOS $IOS_VER${NC}"
    
    case $MODEL in
        iPhone6,*|iPhone7,*|iPhone8,*|iPhone9,*|iPhone10,*)
            echo -e "${CYAN}[i] Arquitectura A7-A11 detectada.${NC}"
            echo -e "${GREEN}[=>] Recomendacion: Utilizar palera1n.${NC}"
            echo -e "\n${YELLOW}Selecciona la modalidad de Jailbreak para palera1n:${NC}"
            echo -e "  1) Rootless  (-l) [Recomendado para iOS 15/16/17]"
            echo -e "  2) Rootful   (-f) [Tradicional / FakeFS]"
            echo -n "Opción [1-2]: "
            read -r jb_type
            
            if [ "$jb_type" == "2" ]; then
                echo -e "\n${GREEN}[+] Iniciando palera1n (Rootful -f)...${NC}"
                palera1n -f
            else
                echo -e "\n${GREEN}[+] Iniciando palera1n (Rootless -l)...${NC}"
                palera1n -l
            fi
            ;;
        iPhone11,*|iPhone12,*)
            echo -e "${CYAN}[i] Arquitectura A12/A13 detectada ($MODEL).${NC}"
            echo -e "${YELLOW}[=>] Recomendacion:${NC}"
            echo -e "     1. Pon el equipo en MODO DFU."
            echo -e "     2. Utiliza la OPCION 3 (USBLiter8 Exploit) en el menu."
            echo -e "     3. En sistema operativo activo puedes usar Dopamine (iOS 15.0 - 16.5.1)."
            ;;
        *)
            echo -e "${CYAN}[i] Modelo $MODEL detectado.${NC}"
            echo -e "${YELLOW}[i] Verifica compatibilidad segun tu version de iOS ($IOS_VER).${NC}"
            ;;
    esac
}

force_revert_menu() {
    echo -e "\n${RED}[!] Opción de Remoción de Jailbreak (Force Revert - palera1n)${NC}"
    echo -e "${YELLOW}Selecciona la modalidad con la que se hizo el Jailbreak en este equipo:${NC}"
    echo -e "  1) Rootless  (-l --force-revert)"
    echo -e "  2) Rootful   (-f --force-revert)"
    echo -n "Opción [1-2]: "
    read -r rev_type
    
    if [ "$rev_type" == "2" ]; then
        echo -e "\n${RED}[+] Ejecutando Force Revert en modo Rootful...${NC}"
        palera1n -f --force-revert
    else
        echo -e "\n${RED}[+] Ejecutando Force Revert en modo Rootless...${NC}"
        palera1n -l --force-revert
    fi
}

run_usbliter8() {
    echo -e "\n${YELLOW}[+] Verificando compatibilidad con USBLiter8 (A12/A13)...${NC}"
    CPID=$(irecovery -q 2>/dev/null | grep "CPID:" | cut -d ' ' -f 2)
    
    if [ "$CPID" == "0x8020" ] || [ "$CPID" == "0x8030" ]; then
        echo -e "${GREEN}[+] Chip compatible detectado ($CPID). Iniciando Suite...${NC}"
        if [ -x "/opt/usbliter8/usbliter8_boot" ]; then
            cd /opt/usbliter8
            ./usbliter8_boot
        elif [ -x "/opt/usbliter8/usbliter8" ]; then
            cd /opt/usbliter8
            ./usbliter8
        else
            echo -e "${RED}[!] No se encontró el binario compilado en /opt/usbliter8.${NC}"
        fi
    else
        echo -e "${RED}[!] Dispositivo incompatible con USBLiter8 (CPID detectado: $CPID).${NC}"
        echo -e "${YELLOW}[i] USBLiter8 es exclusivo para chips A12 y A13.${NC}"
        echo -e "${YELLOW}[i] Tu dispositivo actual es un iPhone 7 (A10 - CPID 0x8010). Usa la Opción 6 (Gaster) y palera1n.${NC}"
    fi
    echo -e "\nPresiona Enter para continuar..."
    read -r
}

install_ipa_menu() {
    mkdir -p /opt/ipas
    while true; do
        clear
        echo -e "${CYAN}====================================================${NC}"
        echo -e "${YELLOW}     GESTOR IPAS [REQUIERE JAILBREAK ACTIVO]        ${NC}"
        echo -e "${CYAN}====================================================${NC}"
        echo -e " ${RED}[AVISO]${NC} La instalación por USB de archivos .ipa vírgenes"
        echo -e " fallará (Error 0xe800801c) a menos que el dispositivo tenga"
        echo -e " un Jailbreak activo que desactive la verificación de firmas."
        echo -e " ----------------------------------------------------"
        echo -e " 1) Descargar última versión de Dopamine desde GitHub"
        echo -e " 2) Ver información sobre TrollStore"
        echo -e " 3) Instalar IPA local almacenada en /opt/ipas/"
        echo -e " 4) Regresar al menú principal"
        echo -e "${CYAN}====================================================${NC}"
        echo -n "Selecciona una opción [1-4]: "
        read -r ipa_opt

        case $ipa_opt in
            1)
                echo -e "\n${YELLOW}[+] Consultando versión y descargando Dopamine desde GitHub...${NC}"
                API_RESPONSE=$(curl -s https://api.github.com/repos/opa334/Dopamine/releases/latest)
                DOPAMINE_VERSION=$(echo "$API_RESPONSE" | grep '"tag_name":' | head -n 1 | cut -d '"' -f 4)
                DOPAMINE_URL=$(echo "$API_RESPONSE" | grep "browser_download_url.*\.ipa" | cut -d '"' -f 4)
                
                if [ -z "$DOPAMINE_VERSION" ]; then
                    DOPAMINE_VERSION="latest"
                fi
                
                TARGET_FILE="/opt/ipas/Dopamine_${DOPAMINE_VERSION}.ipa"
                
                if [ -n "$DOPAMINE_URL" ]; then
                    echo -e "${GREEN}[+] Versión detectada: $DOPAMINE_VERSION. Descargando...${NC}"
                    curl -L "$DOPAMINE_URL" -o "$TARGET_FILE"
                    
                    if [ -f "$TARGET_FILE" ]; then
                        echo -e "${GREEN}[✔] ¡Guardado exitosamente como: $(basename "$TARGET_FILE")!${NC}"
                        echo -e "${YELLOW}[i] ¿Deseas instalarlo ahora en el iPhone? (Recuerda que requiere Jailbreak) (s/n):${NC}"
                        read -r do_inst
                        if [ "$do_inst" == "s" ] || [ "$do_inst" == "S" ]; then
                            echo -e "${CYAN}[+] Instalando en el dispositivo...${NC}"
                            ideviceinstaller install "$TARGET_FILE"
                        fi
                    else
                        echo -e "${RED}[!] Error al guardar el archivo.${NC}"
                    fi
                else
                    echo -e "${RED}[!] No se pudo conectar con GitHub para obtener el enlace.${NC}"
                fi
                echo -e "\nPresiona Enter para continuar..."
                read -r
                ;;
            2)
                echo -e "\n${CYAN}====================================================${NC}"
                echo -e "${YELLOW}                 INFORMACIÓN TROLLSTORE             ${NC}"
                echo -e "${CYAN}====================================================${NC}"
                echo -e " TrollStore requiere ser instalado mediante un instalador"
                echo -e " persistente (como PersistenceHelper o sustitución de Tips)"
                echo -e " dependiendo de si tu equipo ya cuenta con Jailbreak activo."
                echo -e "${CYAN}====================================================${NC}"
                echo -e "\nPresiona Enter para continuar..."
                read -r
                ;;
            3)
                IPAS=( /opt/ipas/*.ipa )
                VALID_IPAS=()
                for ipa in "${IPAS[@]}"; do
                    if [ -f "$ipa" ]; then
                        VALID_IPAS+=("$ipa")
                    fi
                done
                
                if [ ${#VALID_IPAS[@]} -eq 0 ]; then
                    echo -e "\n${RED}[!] No hay archivos .ipa en /opt/ipas/.${NC}"
                else
                    echo -e "\n${GREEN}[+] Archivos IPA disponibles en tu colección:${NC}"
                    i=1
                    for ipa in "${VALID_IPAS[@]}"; do
                        echo -e "  $i) $(basename "$ipa")"
                        ((i++))
                    done
                    echo -n "Elige número a instalar (0 para cancelar): "
                    read -r choice_num
                    if [[ "$choice_num" =~ ^[0-9]+$ ]] && [ "$choice_num" -gt 0 ] && [ "$choice_num" -le "${#VALID_IPAS[@]}" ]; then
                        SELECTED="${VALID_IPAS[$((choice_num-1))]}"
                        echo -e "${YELLOW}[+] Instalando $(basename "$SELECTED")...${NC}"
                        ideviceinstaller install "$SELECTED"
                    fi
                fi
                echo -e "\nPresiona Enter para continuar..."
                read -r
                ;;
            4)
                break
                ;;
            *)
                echo -e "${RED}Opción inválida.${NC}"
                sleep 1
                ;;
        esac
    done
}

extract_shsh() {
    echo -e "\n${YELLOW}[+] Extrayendo datos de ECID, ChipID y Nonce del dispositivo...${NC}"
    mkdir -p /opt/shsh_blobs
    UDID=$(idevice_id -l 2>/dev/null | head -n 1)
    if [ -z "$UDID" ]; then
        UDID=$(ideviceinfo 2>/dev/null | grep "UniqueDeviceID" | cut -d ' ' -f 2)
    fi
    
    if [ -n "$UDID" ]; then
        echo -e "${GREEN}[+] Dispositivo identificado. Obteniendo ECID...${NC}"
        ECID=$(ideviceinfo -u "$UDID" 2>/dev/null | grep "UniqueChipID" | cut -d ' ' -f 2)
        MODEL=$(ideviceinfo -u "$UDID" 2>/dev/null | grep "ProductType" | cut -d ' ' -f 2)
        IOS_VER=$(ideviceinfo -u "$UDID" 2>/dev/null | grep "ProductVersion" | cut -d ' ' -f 2)
        
        echo -e "${CYAN}----------------------------------------${NC}"
        echo -e " Modelo: $MODEL"
        echo -e " iOS Actual: $IOS_VER"
        echo -e " ECID (Hex/Dec): $ECID"
        echo -e "${CYAN}----------------------------------------${NC}"
        echo -e "${GREEN}[✔] Datos obtenidos correctamente.${NC}"
    else
        echo -e "${RED}[!] No se pudo conectar con el dispositivo.${NC}"
    fi
}

battery_diagnostics() {
    echo -e "\n${YELLOW}[+] Consultando estadísticas vitales de la batería...${NC}"
    BAT_INFO=$(ideviceinfo -q com.apple.mobile.battery 2>/dev/null)
    if [ -n "$BAT_INFO" ]; then
        echo -e "${CYAN}========================================${NC}"
        echo -e "         REPORTE DE BATERÍA             "
        echo -e "${CYAN}========================================${NC}"
        echo "$BAT_INFO" | grep -E "BatteryCurrentCapacity|BatteryIsCharging|DesignCapacity|CycleCount|MaximumCapacityPercent"
        echo -e "${CYAN}========================================${NC}"
    else
        echo -e "${RED}[!] No se pudo leer la información de la batería. Desbloquea el equipo.${NC}"
    fi
}

storage_analyzer() {
    echo -e "\n${YELLOW}[+] Analizando almacenamiento interno del iPhone...${NC}"
    echo -e "${CYAN}----------------------------------------${NC}"
    ideviceinfo 2>/dev/null | grep -E "DeviceName|TotalDiskCapacity|TotalSystemCapacity|TotalDataCapacity|MobileBackupSpaceAvailable"
    echo -e "${CYAN}----------------------------------------${NC}"
}

backup_express() {
    echo -e "\n${YELLOW}[+] Iniciando Copia de Seguridad local (Backup Express)...${NC}"
    mkdir -p /opt/iphone_backups
    BACKUP_DIR="/opt/iphone_backups/backup_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    echo -e "${CYAN}[i] El respaldo se guardará en: $BACKUP_DIR${NC}"
    
    if command -v idevicebackup2 &> /dev/null; then
        idevicebackup2 backup "$BACKUP_DIR"
        if [ $? -eq 0 ]; then
            echo -e "\n${GREEN}[✔] ¡Copia de seguridad completada con éxito!${NC}"
        else
            echo -e "\n${RED}[!] Error al realizar el respaldo.${NC}"
        fi
    else
        echo -e "${RED}[!] La herramienta 'idevicebackup2' no está instalada.${NC}"
    fi
}

restore_backup() {
    echo -e "\n${YELLOW}[+] Buscando respaldos locales disponibles...${NC}"
    if [ ! -d "/opt/iphone_backups" ]; then
        echo -e "${RED}[!] No existe la carpeta de respaldos.${NC}"
        return
    fi
    
    BACKUPS=( /opt/iphone_backups/backup_* )
    if [ ${#BACKUPS[@]} -eq 0 ] || [ ! -d "${BACKUPS[0]}" ]; then
        echo -e "${RED}[!] No hay respaldos locales guardados.${NC}"
    else
        echo -e "${GREEN}[+] Respaldos encontrados:${NC}"
        i=1
        for bkp in "${BACKUPS[@]}"; do
            echo -e "  $i) $(basename "$bkp")"
            ((i++))
        done
        echo -n "Elige número de respaldo a restaurar (0 para cancelar): "
        read -r bkp_choice
        if [[ "$bkp_choice" =~ ^[0-9]+$ ]] && [ "$bkp_choice" -gt 0 ] && [ "$bkp_choice" -le "${#BACKUPS[@]}" ]; then
            SELECTED_BKP="${BACKUPS[$((bkp_choice-1))]}"
            echo -e "${YELLOW}[+] Restaurando respaldo desde $(basename "$SELECTED_BKP")...${NC}"
            idevicebackup2 restore "$SELECTED_BKP"
        fi
    fi
}

manage_apps() {
    echo -e "\n${CYAN}====================================================${NC}"
    echo -e "${YELLOW}           ADMINISTRADOR DE APPS (USB)              ${NC}"
    echo -e "${CYAN}====================================================${NC}"
    echo -e " Listando aplicaciones instaladas en el dispositivo..."
    echo -e "${CYAN}----------------------------------------------------${NC}"
    if command -v ideviceinstaller &> /dev/null; then
        ideviceinstaller -l 2>/dev/null | awk -F ' - ' '{print " - " $1}'
    else
        echo -e "${RED}[!] ideviceinstaller no está disponible.${NC}"
    fi
    echo -e "${CYAN}====================================================${NC}"
}

unlock_assistant() {
    echo -e "\n${CYAN}====================================================${NC}"
    echo -e "${YELLOW}           TECLADO PIN REMOTO PARA IPHONE           ${NC}"
    echo -e "${CYAN}====================================================${NC}"
    echo -e " Si la pantalla táctil no responde, ingresa tu PIN de"
    echo -e " desbloqueo numérico dígito por dígito para enviarlo al equipo."
    echo -e "${CYAN}----------------------------------------------------${NC}"
    echo -n "Ingresa el PIN numérico de desbloqueo: "
    read -r user_pin
    
    if [ -n "$user_pin" ]; then
        echo -e "${YELLOW}[+] Enviando secuencia de desbloqueo al iPhone...${NC}"
        iproxy 2222 44 >/dev/null 2>&1 & IPROXY_PID=$!
        sleep 1
        ssh -p 2222 -o StrictHostKeyChecking=no root@127.0.0.1 "uicmd unlock $user_pin 2>/dev/null" &>/dev/null
        kill $IPROXY_PID 2>/dev/null
        echo -e "${GREEN}[✔] Secuencia enviada. Revisa la pantalla de tu iPhone.${NC}"
    else
        echo -e "${RED}[!] PIN inválido o vacío.${NC}"
    fi
}

factory_reset() {
    echo -e "\n${RED}[!] ADVERTENCIA: Esta opción borrará todo el contenido y ajustes del iPhone.${NC}"
    echo -n "¿Estás seguro de ejecutar el restablecimiento de fábrica? (s/n): "
    read -r confirm
    if [ "$confirm" == "s" ] || [ "$confirm" == "S" ]; then
        echo -e "${YELLOW}[+] Enviando orden de borrado general al dispositivo conectado...${NC}"
        idevicediagnostics dark-factory-reset 2>/dev/null || idevicediagnostics restart 2>/dev/null
        echo -e "${GREEN}[+] Comando enviado. El equipo se reiniciará para aplicar el borrado.${NC}"
    else
        echo -e "${YELLOW}[i] Operación cancelada.${NC}"
    fi
}

enter_recovery() {
    echo -e "\n${YELLOW}[+] Buscando UDID del dispositivo...${NC}"
    UDID=$(idevice_id -l 2>/dev/null | head -n 1)
    if [ -z "$UDID" ]; then
        UDID=$(ideviceinfo 2>/dev/null | grep "UniqueDeviceID" | cut -d ' ' -f 2)
    fi
    
    if [ -n "$UDID" ]; then
        echo -e "${GREEN}[+] Enviando dispositivo $UDID a Modo Recovery...${NC}"
        ideviceenterrecovery "$UDID"
    else
        echo -e "${RED}[!] No se pudo obtener el UDID.${NC}"
    fi
}

do_respring() {
    echo -e "\n${YELLOW}[+] Intentando hacer Respring via SSH por USB...${NC}"
    iproxy 2222 44 >/dev/null 2>&1 & IPROXY_PID=$!
    sleep 1
    ssh -p 2222 -o StrictHostKeyChecking=no root@127.0.0.1 "killall -9 SpringBoard" 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}[+] Respring ejecutado con exito.${NC}"
    else
        echo -e "${RED}[!] Fallo al conectar. Asegurate de que el Jailbreak este activo.${NC}"
    fi
    kill $IPROXY_PID 2>/dev/null
}

connect_ssh() {
    echo -e "\n${YELLOW}[+] Abriendo tunel SSH hacia el iPhone (Contraseña por defecto: alpine)${NC}"
    iproxy 2222 44 >/dev/null 2>&1 & IPROXY_PID=$!
    sleep 1
    ssh -p 2222 -o StrictHostKeyChecking=no root@127.0.0.1
    kill $IPROXY_PID 2>/dev/null
}

while true; do
    show_menu
    read -r choice
    case $choice in
        1) smart_jailbreak; echo -e "\nPresiona Enter..."; read -r ;;
        2) force_revert_menu; echo -e "\nPresiona Enter..."; read -r ;;
        3) run_usbliter8 ;;
        4) enter_recovery; echo -e "\nPresiona Enter..."; read -r ;;
        5) irecovery -n ; read -r ;;
        6) gaster pwn 2>/dev/null || echo -e "${RED}gaster no instalado.${NC}" ; read -r ;;
        7) gaster reset 2>/dev/null || true ; read -r ;;
        8) echo -e "\n${YELLOW}Desconecta el USB y manten Bajar Volumen + Encendido para salir de DFU.${NC}" ; read -r ;;
        9) 
            if ideviceinfo &>/dev/null; then
                ideviceinfo | grep -E "ActivationState|ProductVersion|Mode" 2>/dev/null
            else
                echo -e "${YELLOW}[i] El dispositivo no está en Modo Normal. Verificando estado Recovery/DFU...${NC}"
                irecovery -q 2>/dev/null || echo -e "${RED}[!] No se detecta ningún dispositivo conectado.${NC}"
            fi
            read -r 
            ;;
        10) ideviceinfo | grep -E "DeviceName|ProductType|UniqueDeviceID|HardwareModel|CPUArchitecture" 2>/dev/null ; read -r ;;
        11) echo -e "\n${YELLOW}[+] Por favor, acepta el mensaje de 'Confiar' en la pantalla del iPhone.${NC}"; idevicepair pair; read -r ;;
        12) echo -e "\n${YELLOW}[+] Mostrando logs en vivo. Presiona Ctrl+C para salir.${NC}"; sleep 2; idevicesyslog ;;
        13) idevicediagnostics restart 2>/dev/null ; read -r ;;
        14) do_respring; read -r ;;
        15) connect_ssh; read -r ;;
        16) install_ipa_menu ;;
        17) extract_shsh; echo -e "\nPresiona Enter..."; read -r ;;
        18) battery_diagnostics; echo -e "\nPresiona Enter..."; read -r ;;
        19) storage_analyzer; echo -e "\nPresiona Enter..."; read -r ;;
        20) backup_express; echo -e "\nPresiona Enter..."; read -r ;;
        21) restore_backup; echo -e "\nPresiona Enter..."; read -r ;;
        22) manage_apps; echo -e "\nPresiona Enter..."; read -r ;;
        23) unlock_assistant; echo -e "\nPresiona Enter..."; read -r ;;
        24) factory_reset; echo -e "\nPresiona Enter..."; read -r ;;
        25) echo -e "\n${GREEN}Saliendo del menú...${NC}\n" ; exit 0 ;;
        *) echo -e "\n${RED}Opción inválida.${NC}" ; sleep 1 ;;
    esac
done
